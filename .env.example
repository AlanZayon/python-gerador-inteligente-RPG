# Flask API
FLASK_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# Database (PostgreSQL in production, SQLite for local dev)
DATABASE_URL=sqlite:///./arcane_forge.db

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=
PRESIGNED_URL_TTL=86400
S3_DELETE_INPUTS_AFTER_PROCESS=true

# Redis (Upstash or local)
REDIS_URL=redis://localhost:6379/0
JOB_STATUS_TTL=604800

# 9router — OpenAI-compatible gateway (replaces Gemini)
# Dashboard: http://localhost:20128/dashboard
NINEROUTER_URL=http://localhost:20128/v1
NINEROUTER_KEY=
LLM_MODEL=my-combo
LLM_MODEL_LITE=my-combo
LLM_MODEL_FLASH=my-combo
LLM_MODEL_PRO=my-combo
LLM_MAX_TOKENS=8192
LLM_TEMPERATURE=0.7
LLM_TIMEOUT=600
LLM_RETRY_ATTEMPTS=3

# Clerk JWT auth (required in production)
CLERK_JWKS_URL=
CLERK_ISSUER=
# Local dev only — MUST be false in production
AUTH_DEV_MODE=true
AUTH_DEV_USER_ID=dev-user-001
AUTH_DEV_EMAIL=dev@arcane-forge.local
AUTH_DEV_PLAN=studio
AUTH_DEV_CREDITS=999

# Legacy API keys (comma-separated; empty = JWT/dev mode only)
API_KEYS=

# Stripe billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_STUDIO_MONTHLY=
STRIPE_PRICE_CREDITS_5=
STRIPE_PRICE_CREDITS_20=

# Email (Resend)
RESEND_API_KEY=
FROM_EMAIL=Arcane Forge <notifications@arcaneforge.app>

# Sentry
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,https://pdf-translate-vue.vercel.app

# Worker
WORKER_POLL_INTERVAL=2
MAX_JOBS=0
USE_GHA_WORKER=false
GHA_DISPATCH_COOLDOWN=300

# RAG pipeline (local FAISS + 9router)
RAG_INDEX_DIR=./data/indexes
RAG_EMBED_MODEL=paraphrase-multilingual-MiniLM-L12-v2
RAG_CHUNK_MIN_TOKENS=500
RAG_CHUNK_MAX_TOKENS=800
RAG_CHUNK_OVERLAP_TOKENS=100
RAG_TOP_K=8
RAG_CONTEXT_FLOOR_SIMPLES=2500
RAG_CONTEXT_CEILING_SIMPLES=4000
RAG_CONTEXT_FLOOR_MEDIANA=4000
RAG_CONTEXT_CEILING_MEDIANA=6500
RAG_CONTEXT_FLOOR_COMPLEXA=5500
RAG_CONTEXT_CEILING_COMPLEXA=9000
RAG_HAMMING_THRESHOLD=10

# GitHub Actions worker (optional fallback)
GITHUB_REPO_OWNER=
GITHUB_REPO_NAME=
GITHUB_TOKEN=
GITHUB_WORKFLOW_FILE=campaign_worker.yml
GITHUB_BRANCH=main
